# Скопируй в .env и вставь токен бота из https://discord.com/developers/applications
DISCORD_TOKEN=вставь_сюда_токен

# --- Необязательно ---

# Ключ облачной LLM. Если задан — перекрывает llm.api_key из config.yaml.
# Держи его здесь, а не в конфиге: config.yaml уезжает в архив pack.bat.
# LLM_API_KEY=

# Переопределить адрес и модель, не трогая config.yaml (удобно для VPS).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Путь к другому конфигу
# BOT_CONFIG=config.yaml
